# Get a free token at https://genius.com/api-clients (create a client, copy "Client Access Token")
GENIUS_TOKEN=
# Where to store the SQLite cache (local dev only; ignored when DATABASE_URL is set)
LYRICSTATS_DB=./data/lyricstats.db
# Production database. Set this (e.g. a Neon Postgres pooled connection string)
# to use Postgres instead of the local SQLite file. Leave empty for local dev.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
